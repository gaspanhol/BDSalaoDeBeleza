Project salao_beleza {
  database_type: 'SQLite'
  Note: 'Modelo relacional do salão de beleza. Espelha o 01_ddl.sql.'
}

Table cliente {
  id_cliente integer [pk, increment]
  nome varchar(100) [not null, note: 'CHECK: mínimo de 3 caracteres (regra 3)']
  telefone varchar(20) [not null, unique, note: 'Formato (DD) 9XXXX-XXXX. Regra 3']
  data_cadastro date [not null, default: `CURRENT_DATE`]
  email varchar(120) [unique, note: 'Opcional. Regra 18. Adicionado por ALTER TABLE']

  Note: 'Cadastro de clientes. Regra 3: exige nome e telefone.'
}

Table profissional {
  id_profissional integer [pk, increment]
  nome varchar(60) [not null, unique, note: 'CHECK: mínimo de 2 caracteres']
  ativo integer [not null, default: 1, note: 'CHECK: 0 ou 1']

  Note: 'Profissionais do salão.'
}

Table telefone_profissional {
  id_profissional integer [not null]
  telefone varchar(20) [not null, note: 'Formato (DD) 9XXXX-XXXX']

  indexes {
    (id_profissional, telefone) [pk]
  }

  Note: 'Atributo multivalorado de profissional (regra 19).'
}

Table servico {
  id_servico integer [pk, increment]
  nome varchar(60) [not null, unique]
  preco decimal(10,2) [not null, note: 'CHECK: maior que zero. Preço único por serviço (regra 14)']
  duracao_min integer [not null, note: 'Duração mínima em minutos. CHECK > 0']
  duracao_max integer [not null, note: 'Duração máxima em minutos. CHECK: maior ou igual a duracao_min']

  Note: 'Serviços oferecidos. Regras 8 e 14.'
}

Table profissional_servico {
  id_profissional integer [not null]
  id_servico integer [not null]

  indexes {
    (id_profissional, id_servico) [pk]
  }

  Note: 'Relacionamento N:N entre profissional e serviço (regra 13).'
}

Table expediente {
  id_profissional integer [not null]
  dia_semana integer [not null, note: 'CHECK: 0 a 6. Igual a strftime(%w): 0 = domingo']
  hora_inicio varchar(5) [not null, note: 'Formato HH:MM']
  hora_fim varchar(5) [not null, note: 'Formato HH:MM. CHECK: maior que hora_inicio']

  indexes {
    (id_profissional, dia_semana, hora_inicio) [pk]
  }

  Note: 'Entidade fraca de profissional (regra 7). Identificada por profissional, dia e hora de início.'
}

Table indisponibilidade {
  id_indisponibilidade integer [pk, increment]
  id_profissional integer [not null]
  data_hora_inicio varchar(16) [not null, note: 'Formato AAAA-MM-DD HH:MM']
  data_hora_fim varchar(16) [not null, note: 'Formato AAAA-MM-DD HH:MM. CHECK: maior que data_hora_inicio']
  motivo varchar(200)

  Note: 'Bloqueios de horário pelo profissional (regra 10).'
}

Table agendamento {
  id_agendamento integer [pk, increment]
  id_cliente integer [not null]
  id_profissional integer [not null]
  id_servico integer [not null]
  data_hora_inicio varchar(16) [not null, note: 'Formato AAAA-MM-DD HH:MM']
  duracao_efetiva integer [not null, note: 'Em minutos, entre duracao_min e duracao_max do serviço (regra 8)']
  preco_cobrado decimal(10,2) [not null, note: 'Preço congelado no momento da reserva (regra 17)']
  status varchar(12) [not null, default: 'agendado', note: 'CHECK: agendado, concluido, cancelado ou faltou']

  Note: 'Agendamentos. Horário de fim é derivado: data_hora_inicio + duracao_efetiva (não armazenado). Unicidade de horário e sobreposição são garantidas por índices parciais e triggers (ver 04_aprofundamento.sql).'
}

Ref: telefone_profissional.id_profissional > profissional.id_profissional [delete: cascade, update: cascade]
Ref: profissional_servico.id_profissional > profissional.id_profissional [delete: cascade, update: cascade]
Ref: profissional_servico.id_servico > servico.id_servico [delete: cascade, update: cascade]
Ref: expediente.id_profissional > profissional.id_profissional [delete: cascade, update: cascade]
Ref: indisponibilidade.id_profissional > profissional.id_profissional [delete: cascade, update: cascade]
Ref: agendamento.id_cliente > cliente.id_cliente [delete: restrict, update: cascade]
Ref: agendamento.id_profissional > profissional.id_profissional [delete: restrict, update: cascade]
Ref: agendamento.id_servico > servico.id_servico [delete: restrict, update: cascade]
Ref: agendamento.(id_profissional, id_servico) > profissional_servico.(id_profissional, id_servico) [delete: restrict, update: cascade]